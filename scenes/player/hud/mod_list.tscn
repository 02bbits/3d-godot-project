[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/player/hud/mod_list.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/ui/mods/mod_icon.tscn" id="2_icon"]

[node name="ModList" type="PanelContainer"]
visible = false
custom_minimum_size = Vector2(300, 0)
size_flags_vertical = 0
mouse_filter = 2
theme_type_variation = &"HudBoard"
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 14

[node name="V" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Margin/V"]
layout_mode = 2
theme_type_variation = &"HudSubtitle"
theme_override_font_sizes/font_size = 17
text = "YOUR MODIFIERS"

[node name="Rows" type="VBoxContainer" parent="Margin/V"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 10

[node name="Row" type="HBoxContainer" parent="Margin/V/Rows"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 10

[node name="Icon" parent="Margin/V/Rows/Row" instance=ExtResource("2_icon")]
layout_mode = 2
size_flags_vertical = 4

[node name="Text" type="VBoxContainer" parent="Margin/V/Rows/Row"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 0

[node name="Name" type="Label" parent="Margin/V/Rows/Row/Text"]
layout_mode = 2
theme_type_variation = &"HudNameBold"
theme_override_font_sizes/font_size = 15
text = "Swift Boots"

[node name="Summary" type="Label" parent="Margin/V/Rows/Row/Text"]
layout_mode = 2
theme_type_variation = &"HudSmall"
theme_override_font_sizes/font_size = 12
text = "Move speed +30%"

[node name="Pips" type="HBoxContainer" parent="Margin/V/Rows/Row"]
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
theme_override_constants/separation = 4

[node name="Pip" type="Panel" parent="Margin/V/Rows/Row/Pips"]
custom_minimum_size = Vector2(8, 8)
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"ModPip"
