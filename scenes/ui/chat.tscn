[node name="Hint" type="Label" parent="V/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 16
text = "0 online"

[node name="LogPanel" type="PanelContainer" parent="V"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2
theme_type_variation = &"ChatLog"

[node name="Scroll" type="ScrollContainer" parent="V/LogPanel"]
unique_name_in_owner = true
layout_mode = 2
horizontal_scroll_mode = 0
vertical_scroll_mode = 3

[node name="Log" type="VBoxContainer" parent="V/LogPanel/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
mouse_filter = 2
