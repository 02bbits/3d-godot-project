alignment = 2

[node name="Row" type="PanelContainer" parent="V/LogPanel/Scroll/Log"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"ChatPlain"

[node name="Text" type="RichTextLabel" parent="V/LogPanel/Scroll/Log/Row"]
layout_mode = 2
mouse_filter = 2
