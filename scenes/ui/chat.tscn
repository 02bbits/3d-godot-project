[node name="Header" type="HBoxContainer" parent="V"]
unique_name_in_owner = true
layout_mode = 2

[node name="Title" type="Label" parent="V/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"TitleLabel"
